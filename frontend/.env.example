# Optional: explicitly enable local-development component and dashboard demonstrations.
# These routes are always excluded from production, regardless of this value.
VITE_ENABLE_DEV_PREVIEWS=false

# Leave blank until intentionally connecting to a local or approved hosted project.
# Browser-safe publishable key only. Never use a secret/service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# All remain false until the owner approves the corresponding hosted launch steps.
VITE_ENABLE_REGISTRATION=false
VITE_ENABLE_SUBMISSIONS=false
VITE_ENABLE_LEADERBOARD=false
VITE_PRIVACY_APPROVED=false
