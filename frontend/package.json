{
  "name": "ianalyze-academy-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:types": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "check:production": "node scripts/check-production.mjs",
    "check:phase-02": "node scripts/check-phase-02.mjs",
    "test:browser:phase-02": "node scripts/phase-02-browser-qa.mjs",
    "validate": "npm run check:types && npm run lint && npm test && npm run format:check && npm run build && npm run check:production && npm run check:phase-02 && npm run test:database:embedded && npm run check:database-types && npm run check:phase-03",
    "db:types": "node scripts/generate-database-types.mjs",
    "check:database-types": "node scripts/generate-database-types.mjs --check",
    "test:database:embedded": "node --test tests/database.security.test.mjs",
    "test:integration": "node --test tests/supabase.integration.test.mjs",
    "check:phase-03": "node scripts/check-phase-03.mjs",
    "test:database:supabase": "supabase test db --local --workdir ..",
    "test:browser:phase-03": "node scripts/phase-03-browser-qa.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "i18next": "^26.5.12",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^8.5.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postgres": "4.0.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "supabase": "2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
